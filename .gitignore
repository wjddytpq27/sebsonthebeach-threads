# ───────── data/ 전체 제외 (포트폴리오 공개용) ─────────
data/
!data/.gitkeep

.env
*.env

# Threads 브라우저 세션 (Playwright)
session_state.json
data/*.session

# 락 파일 / 캐시
data/locks/
*.lock
__pycache__/
*.pyc
.tsbuildinfo

# 로그 / 디버그 임시파일 (토큰이 에러로 찍힐 수 있어 예방적 제외)
*.log
data/bgpid.txt
data/bgtest.txt
data/engage_debug.txt

# 로컬 백업 (crontab 등)
data/backups/

# 대용량 산출물 (필요시 개별 관리)
*.png
*.pptx

# ───────── 커밋 O (상태 데이터): 명시적 화이트리스트 ─────────
# posts.json, insights.csv, follower_log.csv 등은 커밋돼야 상태 유지됨.
# (위 제외 규칙에 안 걸리므로 자동 포함)

# 파생 캐시 (insights/follower_log에서 매 실행 재생성)
data/post_ledger.json
data/bandit.json
data/builder_notes_candidates.jsonl
data/builder_notes_candidates.archive.jsonl
data/builder_notes.json.bak
data/builder_notes.json.tmp
